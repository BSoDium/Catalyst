# Copy to `.env` (same directory as docker-compose.yml). Every value is optional.
# Docs: docs/self-hosting.md

# ---- tiles (fallback tile server) -------------------------------------------------------
# Directory on the host that contains places.pmtiles (mounted read-only at /data).
# Build the file with `pnpm tiles:extract` (see deploy/tiles/extract-places.mjs).
TILES_DIR=./data/tiles
# Host interface and port. 127.0.0.1 = only reachable from the host itself (put a reverse proxy
# in front, recommended). 0.0.0.0 = reachable from the network.
TILES_BIND=127.0.0.1
TILES_PORT=8080
# "*" (public read-only tiles, default) or a comma separated list of exact origins, e.g.
# https://catalyst.example.com,https://www.example.com
CORS_ALLOW_ORIGINS=*

# ---- app (web + api) ---------------------------------------------------------------------
# "published" (real content) or "demo" (placeholder fixture, never for a public site)
CATALYST_CONTENT=published
WEB_BIND=127.0.0.1
WEB_PORT=3000
API_BIND=127.0.0.1
API_PORT=3001
# Let the web container read the projection from the API container (optional):
# CATALYST_API_URL=http://api:3001

# ---- tile sources read by the web app (contract; see docs/self-hosting.md) -----------------
# Primary style/tile source. Default (when unset): OpenFreeMap.
# CATALYST_TILES_PRIMARY_URL=https://tiles.openfreemap.org/planet
# Your own PMTiles file, served by the tiles service behind HTTPS:
# CATALYST_TILES_FALLBACK_URL=https://tiles.example.com/places.pmtiles
# Highest zoom served from the fallback archive (the extract's maxzoom). Default 14.
# CATALYST_TILES_MAX_FALLBACK_ZOOM=14
