# Which projection to serve: "published" (default), "preview" (local git-ignored file of your real places incl.
# drafts, dev only: `pnpm export:preview` in the private repo) or "demo" (placeholder fixtures, tests only).
# `pnpm dev` chooses preview-or-published by itself; never set preview or demo on a deployment.
CATALYST_CONTENT=published

# Optional. When set, the site fetches `${CATALYST_API_URL}/v1/projection` (2s timeout,
# schema-validated) and falls back to the bundled snapshot on any failure.
# CATALYST_API_URL=https://api.example.com

# Dev server only (`pnpm dev`; builds ignore it). By default it listens on every interface so a phone on the LAN or the
# tailnet can open it. `localhost` keeps it on this machine (do this on a network you do not trust: the preview data is
# served to whoever reaches the port). Extra Host names to accept, comma separated (a leading dot allows a domain):
# CATALYST_DEV_HOST=localhost
# CATALYST_DEV_ALLOWED_HOSTS=phone-test.example.com
